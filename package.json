{
  "name": "shelfmark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:full": "npm run build && wrangler dev --local",
    "db:migrate:local": "wrangler d1 migrations apply shelfmark --local",
    "db:migrate": "wrangler d1 migrations apply shelfmark --remote",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b && tsc -p worker"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "wrangler": "^4.151.0"
  }
}
